#!/usr/bin/env bash
# Runs clip.py inside the clipwright-runtime image (supoclip-backend plus faster-whisper). See README.md.
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Rootless Docker users: use that socket when DOCKER_HOST is not already set.
if [ -z "${DOCKER_HOST:-}" ] && [ -S "/run/user/$(id -u)/docker.sock" ] && ! docker info >/dev/null 2>&1; then
  export DOCKER_HOST="unix:///run/user/$(id -u)/docker.sock"
fi
if ! docker info >/dev/null 2>&1; then
  echo "Cannot reach the Docker daemon. Start Docker (or rootless dockerd) and retry." >&2
  exit 1
fi
IMAGE=clipwright-runtime:latest
if ! docker image inspect "$IMAGE" >/dev/null 2>&1; then
  echo "Image $IMAGE not found. Run ./setup.sh first." >&2
  exit 1
fi
mkdir -p "$HERE"/{tmp,cache,jobs,out}
# signed-in YouTube cookies get unattended fetches past the bot check (README, Autopilot)
if [ -z "${YTDLP_COOKIES:-}" ] && [ -f "$HERE/secrets/youtube-cookies.txt" ]; then
  YTDLP_COOKIES=/work/secrets/youtube-cookies.txt
fi

exec docker run --rm \
  -e TRANSCRIPTION_PROVIDER=whisper \
  -e WHISPER_MODEL_SIZE="${WHISPER_MODEL_SIZE:-small}" \
  ${WHISPER_BACKEND:+-e WHISPER_BACKEND} \
  -e TRANSCRIPTION_LANGUAGE="${TRANSCRIPTION_LANGUAGE:-}" \
  -e TEMP_DIR=/work/tmp \
  -e XDG_CACHE_HOME=/work/cache \
  -e HOME=/work/cache \
  -e PYTHONPATH=/work \
  ${FREESOUND_API_KEY:+-e FREESOUND_API_KEY} \
  ${YTDLP_COOKIES:+-e YTDLP_COOKIES="$YTDLP_COOKIES"} \
  -v "$HERE":/work \
  -v "$HERE/clip.py":/app/clip.py:ro \
  -w /app \
  "$IMAGE" .venv/bin/python /app/clip.py "$@"
